# Gemini Cursor Proxy - Environment Variables Example
# WARNING: DO NOT put real credentials or API keys in this file!
# This file serves as a template and is committed to the public Git repository.

# Proxy Authentication Token (Used by Cursor IDE in the Authorization header)
PROXY_TOKEN=replace_me

# Google Gemini API Keys (one per account / project)
# Configured in Cloudflare via `wrangler secret put <SECRET_NAME>`
GEMINI_KEY_01=replace_me
GEMINI_KEY_02=replace_me
GEMINI_KEY_03=replace_me
GEMINI_KEY_04=replace_me
GEMINI_KEY_05=replace_me
